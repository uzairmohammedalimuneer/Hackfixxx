# ==============================================================================
# HACKFIX AI Configuration Environment Variables (.env)
# ==============================================================================

# Application & Environment
APP_NAME="HACKFIX AI"
ENVIRONMENT="development"

# Google Gemini API Configuration (Leave blank for deterministic fallback)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_ENABLED=true

# Database Persistence (SQLite)
DATABASE_URL="sqlite+aiosqlite:///./hackfix.db"

# Frontend & CORS Configuration
FRONTEND_ORIGIN="http://localhost:3000"

# SSRF and Outbound Scanning Allowlist (for authorized local test websites)
SCAN_ALLOWED_HOSTS=["localhost", "127.0.0.1", "::1", "testserver"]
ALLOW_PRIVATE_IPS_IN_DEV=false

# Scanner Boundaries
MAX_CRAWL_PAGES=25
MAX_CRAWL_DEPTH=2
REQUEST_TIMEOUT_SECONDS=10.0
SCAN_DEADLINE_SECONDS=120.0

# OWASP ZAP Baseline Scanner Integration (Optional, disabled by default)
ZAP_ENABLED=false
ZAP_PATH="zap-baseline.py"
ZAP_DOCKER_IMAGE="zaproxy/zap-baseline:latest"
ZAP_USE_DOCKER=false

